{
  "name": "wfaa/php-config",
  "description": "Shared PHP coding standards and static-analysis config (PHPCS + PHPStan) for WFAA / Wisconsin Foundation WordPress projects.",
  "type": "phpcodesniffer-standard",
  "license": "GPL-2.0-or-later",
  "keywords": ["phpcs", "phpstan", "wordpress", "coding-standards", "wfaa"],
  "authors": [
    {
      "name": "Lee Stratman",
      "email": "lee.stratman@supportuw.org"
    }
  ],
  "require": {
    "php": ">=8.3",
    "squizlabs/php_codesniffer": "^3.13.6",
    "wp-coding-standards/wpcs": "^3.3.0",
    "phpcompatibility/php-compatibility": "^9.3",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpstan/phpstan": "^2.2",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "php-stubs/wp-cli-stubs": "^2.12"
  },
  "bin": ["bin/wfaa-init"],
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
