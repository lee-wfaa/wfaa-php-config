<?xml version="1.0"?>
<ruleset name="PROJECT_NAME">
    <description>
        PHPCS ruleset for PROJECT_NAME.
        Inherits the shared WFAA base from the wfaa/php-config Composer package.
    </description>

    <!-- Inherit the shared base ruleset (installed via Composer). -->
    <rule ref="vendor/wfaa/php-config/phpcs-base.xml"/>

    <!-- Lint this directory; explicit base path keeps reports clean. -->
    <file>.</file>
    <arg name="basepath" value="."/>

    <!-- Errors block (CI gate); warnings (e.g. TODO notes) are reported but
         do not fail the build. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <!-- Project-specific excludes. -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/.phpunit.cache/*</exclude-pattern>

    <!-- Tests: keep structural rules (strict types, arrays, naming), but drop
         the DocBlock ceremony — per-test-method docblocks add noise, not value. -->
    <rule ref="Squiz.Commenting">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Commenting">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Project text domain — replace with this project's text domain. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="TEXT_DOMAIN"/>
            </property>
        </properties>
    </rule>
</ruleset>
