# PHPStan config for PROJECT_NAME.
# Inherits the shared WFAA base from the wfaa/php-config Composer package.
includes:
    - vendor/wfaa/php-config/phpstan-base.neon

parameters:
    # Directories PHPStan analyses — adjust to this project's layout.
    paths:
        - includes

    # Define this project's runtime constants for analysis (the real define()s
    # live in files that can't be executed under PHPStan). Create the file if
    # the project needs it, otherwise remove this key.
    # bootstrapFiles:
    #     - phpstan-bootstrap.php

    # Extra stubs for symbols not covered by the WordPress stub set — e.g.
    # WP-CLI classes (WP_CLI) for `wp` commands, or APIs too new for the
    # bundled stubs. Uncomment / extend as needed.
    #
    # wp-cli-stubs is NOT pulled in by wfaa/php-config: it constrains
    # php-stubs/wordpress-stubs to ^6.0 and would hold every consumer back on
    # WordPress 6.x stubs. Projects that ship `wp` commands should
    # `composer require --dev php-stubs/wp-cli-stubs` themselves and accept
    # that cap knowingly.
    # scanFiles:
    #     - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php

    # ignoreErrors:
    #     # build/**/index.asset.php are generated by `npm run build` and are
    #     # legitimately absent during lint-only analysis. Every require is
    #     # guarded with file_exists(), so a missing manifest is not a real error.
    #     -
    #         identifier: require.fileNotFound
    #         message: '#build/[^"]+/index\.asset\.php" is not a file or it does not exist\.#'
    #         reportUnmatched: false
